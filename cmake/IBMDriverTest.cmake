string(RANDOM LENGTH 12 ALPHABET abcdef0123456789 suffix)
set(directory "${WORK}/driver-${suffix}")
file(MAKE_DIRECTORY "${directory}")
execute_process(COMMAND "${BERYL}" driver --program CLAMPREC --record-bytes 3
  --out "${directory}/source" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "IBM driver generation failed: ${result}")
endif()
set(SOURCE "${directory}/source/driver.cob")
set(OUTPUT "${directory}/driver")
include("${CMAKE_CURRENT_LIST_DIR}/CompileIBM.cmake")
execute_process(COMMAND "${TEST_DRIVER}" "${BERYL}" --prebuilt "${OUTPUT}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "IBM driver execution failed: ${result}")
endif()
